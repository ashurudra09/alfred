# Copy this file to .env and fill in your keys. .env is git-ignored; never commit it.

# Hugging Face write token (Settings -> Access Tokens). Also add it as a Kaggle Secret named HF_TOKEN.
HF_TOKEN=

# Teacher model API (free tier). Groq is the default; fill at least one backup.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional: Google AI Studio key, only used as a cloud reference model in evaluation.
GEMINI_API_KEY=

# Kaggle needs nothing here: the CLI reads %USERPROFILE%\.kaggle\access_token.

