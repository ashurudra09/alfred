{
  "version": "1.0",
  "tools": [
    {
      "name": "search_files",
      "description": "Find files by their name. To search inside file text use search_file_contents; for notes use search_notes.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Text the file NAME should contain",
            "title": "Query",
            "type": "string"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "extension": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "File extension without the dot, e.g. 'pdf'",
            "title": "Extension"
          },
          "modified_within_days": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only files changed in the last N days",
            "title": "Modified Within Days"
          }
        },
        "required": [
          "query",
          "folder"
        ],
        "title": "search_filesArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "alfred/group": "files",
        "alfred/needs_confirmation": false
      }
    },
    {
      "name": "search_file_contents",
