            "title": "Text",
            "type": "string"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "extension": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "File extension without the dot, e.g. 'pdf'",
            "title": "Extension"
          }
        },
        "required": [
          "text",
          "folder"
        ],
        "title": "search_file_contentsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "alfred/group": "files",
        "alfred/needs_confirmation": false
      }
    },
